{
  "name": "@lauvivans/kami",
  "version": "1.1.6",
  "description": "A Notion-based portfolio",
  "type": "module",
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "notion",
    "portfolio",
    "cms"
  ],
  "author": "Laura Vivan",
  "bin": {
    "create-kami": "bin/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:pkg": "vue-tsc -b && vite build --config vite.config.package.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sass": "npx sass src/assets/scss/main.scss:src/assets/css/main.css",
    "watch-sass": "npx sass packages/core/assets/scss/main.scss:packages/core/assets/css/main.css --watch",
    "test:cli": "node ./bin/cli.js",
    "format": "npx prettier --write .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "prepare": "husky",
    "lint:css": "stylelint '**/*.css'",
    "lint:css:fix": "stylelint '**/*.css' --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lauvivans/kami.git"
  },
  "bugs": {
    "url": "https://github.com/lauvivans/kami/issues"
  },
  "homepage": "https://github.com/lauvivans/kami#readme",
  "files": [
    "dist",
    "bin",
    "template",
    "README.md",
    "License"
  ],
  "engines": {
    "node": ">=14"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run --passWithNoTests"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^0.14.0",
    "@iconify/vue": "^5.0.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^25.9.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/language-core": "^3.3.14",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "mitt": "^3.0.1",
    "prettier": "3.9.10",
    "sass": "^1.108.1",
    "semantic-release": "^25.0.9",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "chalk": "^5.6.2",
    "flatted": "^3.4.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  }
}
